    def generate_chart(self): 

        employees = self.ds.get_all_employees()         eligible_count = sum(1 for emp in employees if self.ds.is_eligible(emp))         non_eligible_count = len(employees) - eligible_count 

        labels = ['مؤھل', 'غیر مؤھل']         sizes = [eligible_count, non_eligible_count]         plt.figure(figsize=(4,4)) 

        plt.pie(sizes, labels=labels, autopct='%1.1f%%', startangle=90) 

        plt.title("نسبة أھلیة الموظفین")         chart_file = "chart.png"         plt.savefig(chart_file)         plt.close()         return chart_file 

     

    def export_pdf(self): 

        report = self.ds.generate_report_text()         filename = filedialog.asksaveasfilename(defaultextension=".pdf")         if filename: 

            try: 

                c = canvas.Canvas(filename, pagesize=A4)                 c.setFont("Helvetica-Bold", 16) 

                c.drawString(50, 820, "تقریر الترقیات") 

                c.setFont("Helvetica", 12)                 y = 800                 for line in report.split("\n"): 

                    c.drawString(50, y, line)                     y -= 15                     if y < 100: 

                        c.showPage()                         y = 820                 # إضافة الرسم البیاني في صفحة جدیدة                 c.showPage()                 chart_file = self.generate_chart() 

                c.drawImage(chart_file, 50, 400, width=500, height=300) 

                c.setFont("Helvetica-Oblique", 10) 

                c.drawString(50, 50, "نھایة التقریر") 

                c.save() 

                messagebox.showinfo("نجاح", f"تم حفظ التقریر في {filename}")             except Exception as e: 

                messagebox.showerror("خطأ", f"حدث خطأ أثناء تصدیر PDF: {e}")                 logger.error(f"Error exporting PDF: {e}") 

     

    def export_excel(self): 

        filename = filedialog.asksaveasfilename(defaultextension=".xlsx")         if filename:             try:                 with self.ds.dm.session_scope() as session: 

                    df = pd.read_sql(session.query(Employee).statement, session.bind) 

                header = "تقریر الترقیات"                 with pd.ExcelWriter(filename, engine='xlsxwriter') as writer: 

                    df.to_excel(writer, index=False, startrow=2)                     workbook  = writer.book                     worksheet = writer.sheets['Sheet1']                     header_format = workbook.add_format({'bold': True, 'font_color': 'blue', 'align': 

'center'}) 

                    worksheet.merge_range('A1:D1', header, header_format)                 messagebox.showinfo("نجاح", f"تم حفظ التقریر في {filename}")             except Exception as e: 

                messagebox.showerror("خطأ", f"حدث خطأ أثناء تصدیر Excel: {e}")                 logger.error(f"Error exporting Excel: {e}") 

 

