import os import sys import logging from logging.handlers import RotatingFileHandler from datetime import datetime, timedelta import tkinter as tk from tkinter import ttk, messagebox, filedialog, simpledialog import pandas as pd from sqlalchemy import create_engine, Column, Integer, String, Date, Float, ForeignKey from sqlalchemy.orm import relationship, sessionmaker, declarative_base from reportlab.lib.pagesizes import A4 from reportlab.pdfgen import canvas import matplotlib.pyplot as plt from contextlib import contextmanager 

